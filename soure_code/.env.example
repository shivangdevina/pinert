# Supabase Dashboard > Connect > Session pooler (or Direct connection).
# Use the PostgreSQL database password, NOT an API key. URL-encode the password.
# Keep this file's real counterpart (.env) private.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Backend runtime: configured by `payment-data configure-runtime` AFTER migrations.
# The API refuses to use the owner connection above.
SUPABASE_RUNTIME_DB_URL=

# Future customer access: keep public_demo for the current open synthetic demo.
# Set rbac only AFTER creating Supabase Auth users and assigning roles via access-grant.
DATA_ACCESS_MODE=public_demo

# Required for sign-in when DATA_ACCESS_MODE=rbac.
# Use a publishable key, never a secret key.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Explicit read-only preview APIs/CLI. The chat UI always uses live Supabase.
ENABLE_SYNTHETIC_PREVIEW=false

# Gemini is the selected live provider. Set an available structured-output model.
# The explicit preview always uses the labelled guided parser and makes no model call.
PLANNER_MODE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional compatible adapter configuration (not needed for Gemini).
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1

# Optional Upstash Redis cache: aggregates and validated SQL results only.
# Copy from Upstash Console > Redis database > Connect > REST. Use the standard read/write token.
# These stay on the server. Do not use a readonly token (the cache needs SET with expiry).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_CACHE_ENABLED=false
UPSTASH_CACHE_TTL_SECONDS=120
UPSTASH_CACHE_NAMESPACE=payscope:dev

# Backend (Render): exact Vercel origin(s), comma-separated. No wildcard.
# Leave blank for the existing same-origin local app.
FRONTEND_ORIGINS=

# Frontend build (Vercel): public Render service origin, never a secret.
# Vercel project root must be soure_code; set this in Vercel Environment Variables.
BACKEND_API_URL=
